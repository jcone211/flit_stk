{
  "manifest_version": 3,
  "name": "flit stk - 量化盯盘",
  "version": "1.9.0",
  "description": "轻量浏览器股票监控",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "windows",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.iwencai.com/*",
    "*://*.xueqiu.com/*",
    "https://api.shizixi.com/*",
    "https://hq.sinajs.cn/*",
    "https://qt.gtimg.cn/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
